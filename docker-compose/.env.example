# DebMirror Manager – GHCR-Image-Installation
#
# Datei als ".env" neben compose.yaml speichern.
# Portainer und andere Compose-Stack-Oberflächen verwenden dieselben Variablen
# direkt in ihrer Stack-Umgebung.

# Image:
#   latest = jeweils zuletzt veröffentlichtes Image
#   v1.0.2 = fest auf diese Version begrenzen
DMM_IMAGE_TAG=latest

# Optionalen nginx-Dienst zur HTTP-Auslieferung der Mirror-Daten aktivieren.
# Für reines WebUI ohne nginx leer lassen:
# COMPOSE_PROFILES=
COMPOSE_PROFILES=mirror-http

# WebUI
WEBUI_BIND_ADDRESS=0.0.0.0
WEBUI_PORT=8111

# Optionaler Mirror-HTTP-Dienst
MIRROR_HTTP_BIND_ADDRESS=0.0.0.0
MIRROR_HTTP_PORT=8110

# Persistente Hostpfade
DATA_PATH=/docker_data/debmirror-manager
MIRROR_PATH=/srv/mirror

# Lokale Hostpfade, die beim Import alter Skripte auf /mirror abgebildet werden.
IMPORT_HOST_MIRROR_PATHS=/srv/mirror

# Der Secret Key wird bei einer Neuinstallation automatisch erzeugt und
# persistent unter DATA_PATH/data/app-secret.key gespeichert.
#
# Bei der Übernahme einer bestehenden Installation hier vor dem ersten
# Image-Start unbedingt den bisherigen APP_SECRET_KEY eintragen. Beim ersten
# Start wird er persistent übernommen. Danach kann diese Variable wieder leer
# bleiben.
APP_SECRET_KEY=

# Alte installationsbasierte Adminwerte sind normalerweise nicht erforderlich.
# Neue Installationen erstellen den ersten Administrator über:
#   http://SERVER-IP:8111/setup
APP_USERNAME=
APP_PASSWORD=
APP_PASSWORD_HASH=

# Sitzung und Reverse Proxy
APP_HTTPS_ONLY=0
TRUST_PROXY_HEADERS=0
TRUSTED_HOSTS=
SESSION_LIFETIME_HOURS=12
MIN_PASSWORD_LENGTH=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
LOGIN_LOCK_SECONDS=900
MAX_UPLOAD_BYTES=134217728

# Private/localhost-Ziele für Profilgenerator und URL-Import nur bewusst
# kommasepariert freigeben.
OUTBOUND_PRIVATE_HOST_ALLOWLIST=

# Restore-Schutz
RESTORE_MAX_ENTRIES=10000
RESTORE_MAX_UNCOMPRESSED_BYTES=536870912
RESTORE_MAX_FILE_BYTES=268435456
RESTORE_MAX_COMPRESSION_RATIO=200

# Gunicorn
WSGI_THREADS=8
WSGI_GRACEFUL_TIMEOUT=30
WSGI_KEEPALIVE=5
WSGI_LOG_LEVEL=info
WSGI_ACCESS_LOG=0
WSGI_LIMIT_REQUEST_LINE=4094
WSGI_LIMIT_REQUEST_FIELDS=100
WSGI_LIMIT_REQUEST_FIELD_SIZE=8190

# Scheduler, Warteschlange und Aufbewahrung
SCHEDULER_SCAN_SECONDS=60
MAX_PARALLEL_JOBS=1
JOB_RETENTION_DAYS=31
LOG_RETENTION_DAYS=31
JOB_LIST_LIMIT=100
DASHBOARD_RECENT_JOBS_LIMIT=10
DASHBOARD_EVENTS_LIMIT=10
JOB_STOP_GRACE_SECONDS=20

# Mirror-Zeitabgleich
MIRROR_TIME_SYNC_WORKERS=4
MIRROR_TIME_SYNC_TIMEOUT_SECONDS=15
MIRROR_TIME_SYNC_RECENT_TOLERANCE_SECONDS=5

# Größenberechnung
SIZE_CACHE_TTL_SECONDS=21600
SIZE_CALC_TIMEOUT_SECONDS=1800
SIZE_CALC_MAX_PARALLEL=2
AUTO_SIZE_RECALC_ENABLED=1
AUTO_SIZE_IDLE_MINUTES=120

# Speicherplatz-Sperre
STORAGE_GUARD_ENABLED=1
STORAGE_GUARD_THRESHOLD_PERCENT=95

# Zeitzone
APP_TIMEZONE=Europe/Berlin
